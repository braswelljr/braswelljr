# Server-side GitHub token. Never prefix it with NEXT_PUBLIC_: anything with
# that prefix is compiled into the JavaScript served to the browser.
GITHUB_TOKEN=

# Optional. Origin the server uses to call its own /api routes. Leave unset
# locally so it falls back to localhost. Safe to publish.
# NEXT_PUBLIC_SITE_URL=https://braswelljr.engineer

# Optional. An Upstash Redis database (REST API) for post views and likes.
# Without it the counters under each post simply do not render.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Spotify app credentials and a long-lived refresh token.
# Where to get the refresh token: https://alecchen.dev/spotify-refresh-token
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=
AUTH_SPOTIFY_REFRESH_TOKEN=
